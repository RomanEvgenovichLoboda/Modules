<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_view_form_inherit_basic_means" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit.basic.means</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="hr_maintenance.maintenance_equipment_view_form_inherit_hr"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_basic_means_issue" string="Issue" type="object" class="btn-primary"
                        invisible="basic_means_state != 'in_stock' or not active"
                        groups="maintenance.group_equipment_manager"
                        help="Assign the fixed asset to an employee"/>
                    <button name="action_basic_means_return" string="Return" type="object" class="btn-primary"
                        invisible="basic_means_state != 'issued'"
                        groups="maintenance.group_equipment_manager"
                        confirm="Return the fixed asset to the warehouse?"
                        help="Return the fixed asset from the employee to the warehouse"/>
                    <field name="basic_means_state" widget="statusbar"/>
                </header>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_basic_means_assignments" type="object"
                    class="oe_stat_button" icon="fa-history">
                    <field name="basic_means_assignment_count" string="Issuances" widget="statinfo"/>
                </button>
            </div>
            <!-- While the fixed asset is issued, the assignment is driven by the issuance document -->
            <field name="equipment_assign_to" position="attributes">
                <attribute name="readonly">basic_means_state == 'issued'</attribute>
            </field>
            <field name="employee_id" position="attributes">
                <attribute name="readonly">basic_means_state == 'issued'</attribute>
            </field>
            <field name="employee_id" position="after">
                <field name="basic_means_assignment_id" invisible="not basic_means_assignment_id"/>
            </field>
        </field>
    </record>

    <record id="maintenance_equipment_view_list_inherit_basic_means" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.inherit.basic.means</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="hr_maintenance.maintenance_equipment_view_tree_inherit_hr"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="basic_means_state" widget="badge" optional="show"
                    decoration-success="basic_means_state == 'in_stock'"
                    decoration-warning="basic_means_state == 'issued'"/>
            </field>
        </field>
    </record>

    <record id="maintenance_equipment_view_search_inherit_basic_means" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.inherit.basic.means</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <filter name="my" position="before">
                <filter string="In Stock" name="basic_means_in_stock" domain="[('basic_means_state', '=', 'in_stock')]"/>
                <filter string="Issued" name="basic_means_issued" domain="[('basic_means_state', '=', 'issued')]"/>
                <separator/>
            </filter>
        </field>
    </record>
</odoo>
