<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="basic_means_assignment_rule_company" model="ir.rule">
            <field name="name">Fixed Asset Issuance: multi-company</field>
            <field name="model_id" ref="model_basic_means_assignment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="basic_means_assignment_rule_user" model="ir.rule">
            <field name="name">Fixed Asset Issuance: employees see their own issuances</field>
            <field name="model_id" ref="model_basic_means_assignment"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="basic_means_assignment_rule_manager" model="ir.rule">
            <field name="name">Fixed Asset Issuance: equipment managers see all issuances</field>
            <field name="model_id" ref="model_basic_means_assignment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('maintenance.group_equipment_manager'))]"/>
        </record>
    </data>
</odoo>
